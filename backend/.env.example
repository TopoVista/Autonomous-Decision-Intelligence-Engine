DATABASE_URL=sqlite+aiosqlite:///./decision_intelligence.db
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=your_openai_api_key_here
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
ENCRYPTION_KEY=
SENTRY_DSN=
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3003
MAX_QUERY_ROWS=1000
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
QUERY_TIMEOUT_SECONDS=30
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=120
MAX_CONCURRENT_AGENT_RUNS=2
MAX_CONCURRENT_DB_QUERIES=2
MAX_QUERY_RESULT_BYTES=2097152
SCHEMA_MAX_TABLES=100
SCHEMA_TIMEOUT_SECONDS=20
MAX_SCHEMA_PROMPT_CHARS=50000
MAX_DOCUMENT_CHUNKS=200
MAX_IN_MEMORY_CHUNKS=2000
MAX_ARTIFACTS_PER_SESSION=50
MAX_LOCAL_CACHE_ENTRIES=500
MAX_SPECIALIST_ROWS=500
MAX_SPECIALIST_COLUMNS=5
RATE_LIMIT_REQUESTS=20
CACHE_TTL_SCHEMA=3600
CACHE_TTL_QUERY=300
LLM_TIMEOUT_SECONDS=30
LLM_MODEL=gpt-4o-mini-2024-07-18
# Optional local-LLM fallback tier. Leave empty to keep the deterministic offline
# fallback (used when OPENAI_API_KEY is absent or the API call fails).
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
# Mask PII columns and truncate long strings before row data is sent to the LLM.
REDACT_PII_IN_PROMPTS=true
AUTH_BYPASS=false
UPLOADS_DIR=/tmp/ask-database-uploads
MAX_UPLOAD_BYTES=10485760
